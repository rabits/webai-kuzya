# Copy this file to `.env` and adjust values for your setup.
# Compose interpolates this file; container paths below are Linux paths.

# ── Open WebUI ────────────────────────────────────────────────────────────────
# Bound to loopback by default; public access goes through nginx (lb).
WEBUI_BIND=127.0.0.1
WEBUI_PORT=3000
WEBUI_NAME=Kuzya
WEBUI_SECRET_KEY=change-me
WEBUI_AUTH=true
ENABLE_SIGNUP=true
# Origin browsers use to reach nginx. Host (and optional :port) are also used
# for the self-signed certificate SAN and the HTTP→HTTPS redirect.
# Examples: https://localhost  https://example.com  https://192.168.1.10:8443
WEBUI_URL=https://localhost

# ── nginx (public HTTP→HTTPS reverse proxy) ───────────────────────────────────
HTTP_PORT=80
# Directory mounted into the lb container. Place your own cert here, or leave
# empty and the entrypoint will write a self-signed pair on first start.
TLS_CERT_DIR=./certs
TLS_CERT=fullchain.pem
TLS_KEY=privkey.pem
TLS_DAYS=825

# ── LLM (external vLLM, OpenAI-compatible) ────────────────────────────────────
# vLLM is NOT started by this compose file.
# From a container on Linux, host.docker.internal is mapped to the host gateway.
# Expected API shape: POST {LLM_URL}/chat/completions
LLM_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=sk-local
LLM_MODEL=local-model

# ── STT (Whisper, OpenAI-compatible) ──────────────────────────────────────────
STT_URL=http://stt:8001/v1
STT_API_KEY=sk-local
STT_MODEL=turbo
# openai-whisper names: turbo, large-v3, medium, small, base, tiny
WHISPER_MODEL=turbo
WHISPER_DOWNLOAD_ROOT=/app/models/whisper
# ISO-639-1. Empty string = auto-detect (slower).
WHISPER_LANGUAGE=ru

# ── TTS (F5-TTS, OpenAI-compatible) ───────────────────────────────────────────
TTS_URL=http://tts:8002/v1
TTS_API_KEY=sk-local
TTS_MODEL=f5-tts
TTS_TIMEOUT=120

F5_MODEL_NAME=F5TTS_v1_Base
F5_MODEL_PATH=/app/models/f5tts-russian/model_last_inference.safetensors
F5_VOCAB_PATH=/app/models/f5tts-russian/vocab.txt

# ── Voices ────────────────────────────────────────────────────────────────────
VOICES_DIR=/app/models/voices
DEFAULT_VOICE=default
